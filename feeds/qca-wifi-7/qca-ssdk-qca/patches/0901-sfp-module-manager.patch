+/* ===================== SFP_MODULE_MANAGER =====================
+ * Runtime supervision for the SFP+ port. Goals:
+ *   1) insertion is noticed immediately and the module is re-probed by
+ *      forcing a MAC/PCS re-init, instead of waiting for the AN state
+ *      machine to crawl up (measured ~83s on a 2.5G stick);
+ *   2) if the port stays down while a module is seated, simulate a module
+ *      power cycle (TX_DISABLE pulse + PCS restart) as a boot fallback;
+ *   3) every state change is logged at INFO so it is visible with the
+ *      default log level (/sys/ssdk/log_level = 2).
+ *
+ * Per-tick details stay at DEBUG (log_level 3) to avoid perturbing timing.
+ */
+#define SFP_MGR_BOOT_TICKS	12	/* ~12s down before the first try    */
+#define SFP_MGR_RETRY_TICKS	30	/* ~30s down before the second       */
+#define SFP_MGR_LAST_TICKS	60	/* ~60s down before the third        */
+#define SFP_MGR_PULSE_MAX	3
+#define SFP_MGR_HOLD_MS		3000
+#define SFP_MGR_BOUNCE_MS	2000	/* time spent in the throw-away mode */
+
+static a_bool_t   sfp_mgr_present[SW_MAX_NR_DEV][SW_MAX_NR_PORT];
+static a_uint32_t sfp_mgr_down[SW_MAX_NR_DEV][SW_MAX_NR_PORT];
+static a_uint32_t sfp_mgr_pulse[SW_MAX_NR_DEV][SW_MAX_NR_PORT];
+static a_uint32_t sfp_mgr_elapsed[SW_MAX_NR_DEV][SW_MAX_NR_PORT];
+
+/* ---- runtime debug knobs, validation builds only -------------------
+ * /sys/module/qca_ssdk/parameters/sfp_dbg        1 = diag line every 5 ticks
+ * sfp_force_mode = <mode>; echo 1 > sfp_kick -> force mode + PCS restart
+ * This lets a single boot sweep interface modes without reflashing.
+ */
+static int sfp_dbg = 0;
+static int sfp_force_mode = -1;
+static int sfp_kick = 0;
+module_param(sfp_dbg, int, 0644);
+module_param(sfp_force_mode, int, 0644);
+module_param(sfp_kick, int, 0644);
+
+static void
+adpt_hppe_sfp_diag(a_uint32_t dev_id, a_uint32_t port_id,
+	struct port_phy_status *phy_status, a_uint32_t ticks)
+{
+	fal_port_interface_mode_t cur = PORT_INTERFACE_MODE_MAX;
+	fal_port_interface_mode_t calc = PORT_INTERFACE_MODE_MAX;
+	struct phy_device *phydev = NULL;
+	a_bool_t los = A_FALSE;
+	sw_error_t rv;
+
+	adpt_hppe_port_interface_mode_get(dev_id, port_id, &cur);
+	calc = cur;
+	rv = sfp_phy_interface_get_mode_status(dev_id, port_id, &calc);
+	SSDK_INFO("port%d diag t=%u: dt=%d cur=%d calc=%d rv=%d link=%d spd=%d\n",
+		port_id, ticks, ssdk_dt_get_port_mode(dev_id, port_id), cur, calc,
+		rv, phy_status ? phy_status->link_status : -1,
+		phy_status ? phy_status->speed : -1);
+	if (hsl_port_phydev_get(dev_id, port_id, &phydev) == SW_OK && phydev)
+		SSDK_INFO("port%d diag: an=%d phylink=%d physpd=%d\n", port_id,
+			phydev->autoneg, phydev->link, phydev->speed);
+	if (sfp_phy_rx_los_status_get(dev_id, port_id, &los) == SW_OK)
+		SSDK_INFO("port%d diag: rx_los=%d\n", port_id, los);
+}
+
+/* The cage on this board exposes rx_los and tx_disable but no mod-present
+ * pin, so presence cannot be read from a GPIO. Fall back to "assume seated"
+ * and rely on link/LOS behaviour instead of pretending to know. */
+static a_bool_t
+adpt_hppe_sfp_module_present(a_uint32_t dev_id, a_uint32_t port_id)
+{
+	a_bool_t present = A_FALSE;
+	sw_error_t rv;
+
+	rv = sfp_phy_mod_present_status_get(dev_id, port_id, &present);
+	if (rv != SW_OK)
+		return A_TRUE;
+
+	return present;
+}
+
+static void
+adpt_hppe_sfp_power_pulse(a_uint32_t dev_id, a_uint32_t port_id)
+{
+	sw_error_t rv;
+	a_bool_t pulsed = A_FALSE;
+
+	SSDK_INFO("port%d sfp recovery attempt: TX_DISABLE hold %dms\n",
+		port_id, SFP_MGR_HOLD_MS);
+
+	rv = sfp_phy_tx_dis_status_set(dev_id, port_id, A_TRUE);
+	if (rv == SW_OK) {
+		aos_mdelay(SFP_MGR_HOLD_MS);
+		rv = sfp_phy_tx_dis_status_set(dev_id, port_id, A_FALSE);
+		if (rv == SW_OK)
+			pulsed = A_TRUE;
+		else
+			SSDK_ERROR("port%d sfp TX_DISABLE release failed rv=%d\n",
+				port_id, rv);
+	} else {
+		/* The ER2 cage has no sfp_tx_dis_pin in DT, so this call returns
+		 * SW_NOT_SUPPORTED (-19): TX_DISABLE cannot be pulsed at all.
+		 *
+		 * Bench measurement on a 2.5G stick after a warm reboot:
+		 *   - interface mode is already correct (23/2500BASE-X), rv=0,
+		 *     but the module reports link=0 forever;
+		 *   - forcing another mode and coming back (SGMII <-> 2500BASE-X)
+		 *     brings the link up in under a second, and it then stays up
+		 *     for minutes with no flapping.
+		 * So emulate a re-seat by bouncing through a throw-away mode:
+		 * it restarts the UNIPHY/PCS line coding, which is what makes the
+		 * module re-train. A repeat apply of the same mode is a no-op and
+		 * does nothing, which is why the old PCS-only path never worked. */
+		fal_port_interface_mode_t target, bounce;
+
+		target = (fal_port_interface_mode_t)ssdk_dt_get_port_mode(dev_id,
+			port_id);
+		bounce = (target == PHY_SGMII_BASET) ?
+			PORT_SGMII_PLUS : PHY_SGMII_BASET;
+		SSDK_INFO("port%d sfp no tx_disable (rv=%d): mode bounce %d->%d->%d\n",
+			port_id, rv, target, bounce, target);
+		_adpt_hppe_port_interface_mode_set(dev_id, port_id, bounce);
+		_adpt_hppe_port_interface_mode_apply(dev_id, A_FALSE);
+		aos_mdelay(SFP_MGR_BOUNCE_MS);
+		_adpt_hppe_port_interface_mode_set(dev_id, port_id, target);
+		_adpt_hppe_port_interface_mode_apply(dev_id, A_FALSE);
+		pulsed = A_TRUE;
+	}
+
+	/* restart PCS/AN from scratch - this is what a physical re-seat does */
+	adpt_hppe_port_interface_mode_switch_mac_reset(dev_id, port_id);
+	SSDK_INFO("port%d sfp recovery attempt done (pulse=%d)\n",
+		port_id, pulsed);
+}
+
+static void
+adpt_hppe_sfp_module_manager(struct qca_phy_priv *priv, a_uint32_t port_id,
+	struct port_phy_status *phy_status)
+{
+	a_uint32_t dev_id = priv->device_id;
+	a_bool_t present;
+	sw_error_t rv = SW_OK;
+	a_uint32_t due;
+
+	if (A_TRUE != hsl_port_is_sfp(dev_id, port_id))
+		return;
+
+	present = adpt_hppe_sfp_module_present(dev_id, port_id);
+
+	if (sfp_kick) {
+		sfp_kick = 0;
+		if (sfp_force_mode >= 0) {
+			SSDK_INFO("port%d kick: force mode %d (was %d)\n", port_id,
+				sfp_force_mode,
+				ssdk_dt_get_port_mode(dev_id, port_id));
+			_adpt_hppe_port_interface_mode_set(dev_id, port_id,
+				(fal_port_interface_mode_t)sfp_force_mode);
+			_adpt_hppe_port_interface_mode_apply(dev_id, A_FALSE);
+		}
+		adpt_hppe_port_interface_mode_switch_mac_reset(dev_id, port_id);
+		SSDK_INFO("port%d kick done\n", port_id);
+	}
+
+	if (sfp_dbg && ((sfp_mgr_down[dev_id][port_id] % 5) == 0))
+		adpt_hppe_sfp_diag(dev_id, port_id, phy_status,
+			sfp_mgr_down[dev_id][port_id]);
+
+	/* insertion / removal edge */
+	if (present != sfp_mgr_present[dev_id][port_id]) {
+		sfp_mgr_present[dev_id][port_id] = present;
+		sfp_mgr_down[dev_id][port_id] = 0;
+		sfp_mgr_pulse[dev_id][port_id] = 0;
+		sfp_mgr_elapsed[dev_id][port_id] = 0;
+		if (present) {
+			SSDK_INFO("port%d sfp module inserted: force re-init\n",
+				port_id);
+			rv = adpt_hppe_port_interface_mode_switch_mac_reset(dev_id,
+				port_id);
+			if (rv != SW_OK)
+				SSDK_DEBUG("port%d sfp re-init rv=%d\n",
+					port_id, rv);
+		} else {
+			SSDK_INFO("port%d sfp module removed\n", port_id);
+		}
+	}
+
+	if (phy_status->link_status == PORT_LINK_UP) {
+		if (sfp_mgr_pulse[dev_id][port_id] || sfp_mgr_elapsed[dev_id][port_id])
+			SSDK_INFO("port%d sfp link up: %d tick(s), %d pulse(s)\n",
+				port_id, sfp_mgr_elapsed[dev_id][port_id],
+				sfp_mgr_pulse[dev_id][port_id]);
+		sfp_mgr_down[dev_id][port_id] = 0;
+		sfp_mgr_pulse[dev_id][port_id] = 0;
+		sfp_mgr_elapsed[dev_id][port_id] = 0;
+		return;
+	}
+
+	if (sfp_mgr_down[dev_id][port_id] < 0xffff)
+		sfp_mgr_down[dev_id][port_id]++;
+	if (sfp_mgr_elapsed[dev_id][port_id] < 0xffff)
+		sfp_mgr_elapsed[dev_id][port_id]++;
+
+	SSDK_DEBUG("port%d sfp down=%d ticks present=%d pulses=%d\n", port_id,
+		sfp_mgr_down[dev_id][port_id], present,
+		sfp_mgr_pulse[dev_id][port_id]);
+
+	due = (sfp_mgr_pulse[dev_id][port_id] == 0) ? SFP_MGR_BOOT_TICKS :
+		((sfp_mgr_pulse[dev_id][port_id] == 1) ? SFP_MGR_RETRY_TICKS :
+		SFP_MGR_LAST_TICKS);
+	if ((sfp_mgr_down[dev_id][port_id] == due) &&
+	    (sfp_mgr_pulse[dev_id][port_id] < SFP_MGR_PULSE_MAX)) {
+		sfp_mgr_pulse[dev_id][port_id]++;
+		SSDK_INFO("port%d sfp still down after %d ticks, pulse %d/%d\n",
+			port_id, sfp_mgr_down[dev_id][port_id],
+			sfp_mgr_pulse[dev_id][port_id], SFP_MGR_PULSE_MAX);
+		adpt_hppe_sfp_power_pulse(dev_id, port_id);
+		sfp_mgr_down[dev_id][port_id] = 0;
+	}
+}
