#!/bin/sh
# 首次启动（overlay 还是 tmpfs）时把 p24 格式化成 overlay 载体。
# 幂等：已经准备好就直接退出。准备好之后需要重启一次才会接管。
DEV=/dev/mmcblk0p24
MNT=/mnt/.p24

[ -b "$DEV" ] || exit 0

mkdir -p "$MNT"
if mount "$DEV" "$MNT" 2>/dev/null; then
	if [ -d "$MNT/upper" ] && [ -d "$MNT/work" ]; then
		umount "$MNT"
		exit 0
	fi
	umount "$MNT"
fi

mkfs.ext4 -q -F -L rootfs_data "$DEV" || exit 0
mount "$DEV" "$MNT" || exit 0
mkdir -p "$MNT/upper" "$MNT/work"
umount "$MNT"
logger -t extroot "p24 已准备好，重启后 /overlay 生效"
exit 0
