# ER2：把 eMMC p24（vendor 的 plugin 分区，1GiB）当持久 overlay 用。
# 板子默认 overlay 是 tmpfs（rootfs_data 卷只有 128 字节头、没格式化，
# fstools 回落到 ramoverlay），所以配置和装的应用重启就丢。
# 这里按 QWRT 的做法挂一块 ext4 分区到 /overlay，block extroot 会在
# mount_root 阶段接管，之后的 /etc/config 与 apk 安装都落在 p24 上。
config global
	option	anon_swap	0
	option	anon_mount	0
	option	auto_swap	1
	option	auto_mount	1
	option	delay_root	5
	option	check_fs	0

config mount
	option	target	/overlay
	option	device	/dev/mmcblk0p24
	option	fstype	ext4
	option	enabled	1
