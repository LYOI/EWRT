 =?UTF-8?q?=E5=83=8F=E7=9C=9F=E7=9A=84=E5=B8=A6=20mkfs.f2fs=20=E6=97=B6?=
 =?UTF-8?q?=E9=80=89=20f2fs=EF=BC=8C=E5=B9=B6=E7=BB=99=20rootfs=5Fdata=20?=
 =?UTF-8?q?=E9=A2=84=E7=95=99=2064MiB?=
